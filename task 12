from decimal import Decimal, ROUND_HALF_UP

BASE_RATE = Decimal("30.00")
FAT_STANDARD = Decimal("3.5")
SNF_STANDARD = Decimal("8.5")
FAT_STEP_VALUE = Decimal("0.40")
SNF_STEP_VALUE = Decimal("0.30")

SUMMER_BASE_RATE = Decimal("32.00")
SUMMER_FAT_STEP = Decimal("0.45")

BONUS_RATE = Decimal("0.50")
BONUS_LIMIT = Decimal("500.00")

def rate_card(month):
    if 4 <= month <= 6:
        return SUMMER_BASE_RATE, SUMMER_FAT_STEP
    return BASE_RATE, FAT_STEP_VALUE

def round_money(value):
    return value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)

def rate_per_litre(fat, snf, month):
    fat_value = Decimal(str(fat))
    snf_value = Decimal(str(snf))

    base_rate, fat_step = rate_card(month)

    fat_steps = ((fat_value - FAT_STANDARD) / Decimal("0.1"))
    fat_steps = fat_steps.quantize(Decimal("1"), rounding=ROUND_HALF_UP)

    snf_steps = ((snf_value - SNF_STANDARD) / Decimal("0.1"))
    snf_steps = snf_steps.quantize(Decimal("1"), rounding=ROUND_HALF_UP)

    rate = base_rate + (Decimal(fat_steps) * fat_step) + (Decimal(snf_steps) * SNF_STEP_VALUE)
    return round_money(rate)

def bonus_amount(litres):
    litres = Decimal(str(litres))
    if litres > BONUS_LIMIT:
        extra = litres - BONUS_LIMIT
        return round_money(extra * BONUS_RATE)
    return Decimal("0.00")

def payout(litres, fat, snf, month):
    litres = Decimal(str(litres))
    rate = rate_per_litre(fat, snf, month)
    amount = litres * rate
    amount = round_money(amount)
    bonus = bonus_amount(litres)
    total = amount + bonus
    return round_money(total)

print(rate_per_litre(4.20, 8.70, 11))
print(rate_per_litre(4.20, 8.70, 5))
print(payout(600, 4.00, 8.70, 5))