BASE_RATE = 30.00
FAT_STANDARD = 3.5
SNF_STANDARD = 8.5
FAT_STEP_VALUE = 0.40
SNF_STEP_VALUE = 0.30
MIN_FAT = 2.0
MAX_FAT = 7.0

def rate_per_litre(fat, snf):
    fat_steps = round((fat - FAT_STANDARD) / 0.1)
    snf_steps = round((snf - SNF_STANDARD) / 0.1)
    rate = BASE_RATE + fat_steps * FAT_STEP_VALUE + snf_steps * SNF_STEP_VALUE
    return round(rate, 2)

def payout(litres, fat, snf):
    if litres < 0:
        raise ValueError("Litres cannot be negative")
    if fat < MIN_FAT or fat > MAX_FAT:
        raise ValueError("Fat must be between 2.0 and 7.0")
    if snf < 8.0 or snf > 10.0:
        raise ValueError("SNF out of valid range")
    rate = rate_per_litre(fat, snf)
    return round(litres * rate, 2)

def ten_day_total(entries):
    total = 0.0
    for litres, fat, snf in entries:
        total += payout(litres, fat, snf)
    return round(total, 2)

assert payout(10, 3.5, 8.5) == 300.00
assert payout(8.5, 4.2, 8.7) == 283.90
assert payout(12, 3.1, 8.3) == 333.60
assert payout(5, 7.0, 8.5) == 220.00
assert ten_day_total([(10, 3.5, 8.5), (8.5, 4.2, 8.7)]) == 583.90

for data in [(-1, 3.5, 8.5), (10, 1.5, 8.5), (10, 8.0, 8.5)]:
    try:
        payout(data[0], data[1], data[2])
        print("Unexpected success", data)
    except ValueError:
        print("Rejected", data)

print("All tests passed")